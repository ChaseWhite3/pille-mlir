module {
  smt.solver() : () -> () {
    smt.set_logic "QF_BV" loc(#loc1)
    %start_0 = smt.declare_fun "start_0" : !smt.bv<8> loc(#loc1)
    %start_1 = smt.declare_fun "start_1" : !smt.bv<8> loc(#loc1)
    %start_2 = smt.declare_fun "start_2" : !smt.bv<8> loc(#loc1)
    %c1_bv8 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc2)
    %c0_bv8 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc2)
    %c1_bv8_0 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc2)
    %0 = smt.eq %start_1, %c1_bv8 : !smt.bv<8> loc(#loc2)
    %1 = smt.ite %0, %c0_bv8, %c1_bv8_0 : !smt.bv<8> loc(#loc2)
    %c1_bv8_1 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc3)
    %c0_bv8_2 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc4)
    %c1_bv8_3 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc5)
    %c1_bv8_4 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc6)
    %c0_bv8_5 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc7)
    %c1_bv8_6 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc8)
    %c0_bv8_7 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc9)
    %c0_bv8_8 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc10)
    %c1_bv8_9 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc11)
    %c1_bv8_10 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc12)
    %c0_bv8_11 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc12)
    %2 = smt.eq %c0_bv8_8, %c1_bv8_9 : !smt.bv<8> loc(#loc12)
    %3 = smt.ite %2, %c1_bv8_10, %c0_bv8_11 : !smt.bv<8> loc(#loc12)
    %c1_bv8_12 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc13)
    %c1_bv8_13 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc14)
    %c0_bv8_14 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc14)
    %4 = smt.eq %c1_bv8_12, %c1_bv8_13 : !smt.bv<8> loc(#loc14)
    %5 = smt.ite %4, %1, %c0_bv8_14 : !smt.bv<8> loc(#loc14)
    %c1_bv8_15 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc15)
    %c0_bv8_16 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc15)
    %6 = smt.eq %5, %c1_bv8_15 : !smt.bv<8> loc(#loc15)
    %7 = smt.ite %6, %3, %c0_bv8_16 : !smt.bv<8> loc(#loc15)
    %c1_bv8_17 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc16)
    %c1_bv8_18 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc16)
    %8 = smt.eq %start_0, %c1_bv8_17 : !smt.bv<8> loc(#loc16)
    %9 = smt.ite %8, %c1_bv8_18, %7 : !smt.bv<8> loc(#loc16)
    %c0_bv8_19 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc1)
    %10 = smt.eq %start_0, %c0_bv8_19 : !smt.bv<8> loc(#loc1)
    %c1_bv8_20 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc1)
    %11 = smt.eq %start_0, %c1_bv8_20 : !smt.bv<8> loc(#loc1)
    %12 = smt.or %10, %11 loc(#loc1)
    smt.assert %12 loc(#loc1)
    %c0_bv8_21 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc1)
    %13 = smt.eq %start_0, %c0_bv8_21 : !smt.bv<8> loc(#loc1)
    smt.assert %13 loc(#loc1)
    %c0_bv8_22 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc1)
    %14 = smt.eq %start_1, %c0_bv8_22 : !smt.bv<8> loc(#loc1)
    %c1_bv8_23 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc1)
    %15 = smt.eq %start_1, %c1_bv8_23 : !smt.bv<8> loc(#loc1)
    %16 = smt.or %14, %15 loc(#loc1)
    smt.assert %16 loc(#loc1)
    %c0_bv8_24 = smt.bv.constant #smt.bv<0> : !smt.bv<8> loc(#loc1)
    %17 = smt.eq %start_2, %c0_bv8_24 : !smt.bv<8> loc(#loc1)
    %c1_bv8_25 = smt.bv.constant #smt.bv<1> : !smt.bv<8> loc(#loc1)
    %18 = smt.eq %start_2, %c1_bv8_25 : !smt.bv<8> loc(#loc1)
    %19 = smt.or %17, %18 loc(#loc1)
    smt.assert %19 loc(#loc1)
    %pille_result = smt.declare_fun "pille_result" : !smt.bv<8> loc(#loc1)
    %20 = smt.eq %pille_result, %9 : !smt.bv<8> loc(#loc1)
    smt.assert %20 loc(#loc1)
    %c-1_bv1 = smt.bv.constant #smt.bv<-1> : !smt.bv<1> loc(#loc1)
    %pille_defined = smt.declare_fun "pille_defined" : !smt.bv<1> loc(#loc1)
    %21 = smt.eq %pille_defined, %c-1_bv1 : !smt.bv<1> loc(#loc1)
    smt.assert %21 loc(#loc1)
    smt.check sat {
    } unknown {
    } unsat {
    } loc(#loc1)
  } loc(#loc1)
} loc(#loc)
#loc = loc("<stdin>":1:1)
#loc1 = loc("<stdin>":2:3)
