#lang rhombus/static

import:
  pille/mlir

// The |{ ... }| delimiter keeps MLIR's @symbol names literal.
def add_module = mlir.Module(@str|{
  module {
    func.func @add(%lhs: i32, %rhs: i32) -> i32 {
      %sum = arith.addi %lhs, %rhs : i32
      return %sum : i32
    }
  }
}|)

def lowered = add_module.run_passes(
  "builtin.module(convert-arith-to-llvm,convert-func-to-llvm,reconcile-unrealized-casts)"
)
println(lowered.to_llvm_ir())
