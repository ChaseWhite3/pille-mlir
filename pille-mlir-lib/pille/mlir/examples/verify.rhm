#lang rhombus/static/and_meta

import:
  pille/mlir/dialect open
  pille/mlir/smt

// Requires MLIR, the SMT query plugin (PILLE_MLIR_SMT_PLUGIN), and Z3. See the
// package README for how to build the plugin.

constraint Integer:
  same("T", i32 || i64)

// One declaration gives an operation its structure and its meaning. The
// convenience macro below supplies the signature; `smt:` supplies the model,
// instantiated at each instance's actual width.
declaration.macro 'binary $(name :: Identifier): $meaning':
  'operation $name(lhs: Integer, rhs: Integer) -> (out: Integer):
     smt:
       out = $meaning(lhs, rhs)'

dialect arithmetic("arithmetic"):
  binary add: bv.add
  binary sub: bv.sub

// An ordinary program in the custom dialect. IRDL verifies its structure.
def program = arithmetic.module(@str{
  module {
    func.func @"@"round_trip(%x: i32, %y: i32) -> i32 {
      %sum = "@(arithmetic.operation_name("add"))"(%x, %y) : (i32, i32) -> i32
      %difference = "@(arithmetic.operation_name("sub"))"(%sum, %y) : (i32, i32) -> i32
      return %difference : i32
    }
    func.func @"@"successor(%x: i32) -> i32 {
      %one = arith.constant 1 : i32
      %next = "@(arithmetic.operation_name("add"))"(%x, %one) : (i32, i32) -> i32
      return %next : i32
    }
  }
})

def x = smt.input("x", ~width: 32)
def y = smt.input("y", ~width: 32)
def result = smt.result(~width: 32)

// True under wrapping arithmetic: (x + y) - y == x for every x and y.
def round_trip = arithmetic.smt_query(program,
                                      ~function: "round_trip",
                                      ~inputs: [x, y],
                                      ~property: smt.eq(result, x))

// The query is a verified SMT dialect module, exported without a solver.
println(round_trip.module.to_ir())
println(round_trip.to_smtlib())
println(round_trip.check().describe())

// False: x + 1 == x has a counterexample, reported by argument name.
def successor = arithmetic.smt_query(program,
                                     ~function: "successor",
                                     ~inputs: [x],
                                     ~property: smt.eq(result, x))
match successor.check()
| counterexample :: smt.Counterexample:
    println(counterexample.describe())
| outcome:
    println("unexpected: " ++ outcome.describe())
