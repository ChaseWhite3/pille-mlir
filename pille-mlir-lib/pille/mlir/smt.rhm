#lang rhombus/static

import:
  pille/mlir
  lib("pille/private/mlir/query.rkt") as query
  lib("pille/private/mlir/solver.rkt") as solver
  lib("pille/private/mlir/session.rkt") as session

export:
  Term
  Formula
  Precondition
  precondition
  Query
  Spec
  Batch
  ObjectiveQuery
  Optimum
  ValuesSpec
  ValuesQuery
  ValuesBatch
  Values
  Session
  Scope
  Assignment
  Outcome
  Proved
  Counterexample
  Infeasible
  Unknown
  Timeout
  Failure
  input
  result
  const
  add
  sub
  mul
  eq
  not
  and
  or
  ult
  ule
  ugt
  uge
  slt
  sle
  sgt
  sge
  ite
  no_overflow_add
  no_overflow_sub
  no_overflow_mul

// A bitvector-sorted value with an exact width. Terms and Boolean predicates
// are separate sorts: a one-bit term is never usable as a predicate.
veneer Term(this :: satisfying(query.is_term)):
  constructor ~error

  property width :: Int:
    query.term_width(this)

  method describe() :: String:
    query.render_term(this)

// An SMT Boolean predicate over terms.
veneer Formula(this :: satisfying(query.is_formula)):
  constructor ~error

  method describe() :: String:
    query.render_formula(this)

// A precondition with a name, for a query's ~preconditions list. Where a
// query's named preconditions cannot hold together, its outcome is
// `Infeasible`, naming a set of them that cannot. A name is a nonempty string
// without bars, backslashes or line breaks ("event-phases.md:22"), and is
// distinct within a query.
veneer Precondition(this :: satisfying(query.is_named)):
  constructor ~error

fun precondition(formula :: Formula, ~named: name :: ReadableString) :: Precondition:
  query.smt_named(formula, to_string(name))

// A function argument. Its position is its index in a query's ~inputs list;
// the name is how counterexamples report it.
fun input(name :: ReadableString, ~width: width :: Int) :: Term:
  query.smt_input(to_string(name), width)

// The value returned by the selected function: `result(~width: w)` of a
// function with one result, `result(index, ~width: w)` for one of the values
// a function with several returns, counted from 0.
fun
| result(~width: width :: Int) :: Term:
    query.smt_result(width)
| result(index :: NonnegInt, ~width: width :: Int) :: Term:
    query.smt_result_at(index, width)

// A typed literal in [-2^(w-1), 2^w - 1]; negative values denote their two's
// complement residue. Out-of-range values are rejected.
fun const(value :: Int, ~width: width :: Int) :: Term:
  query.smt_const(value, width)

// Wrapping arithmetic on terms of equal width. Sorts are checked by the
// builder so that a mistake names both operands.
fun add(lhs, rhs) :: Term:
  query.smt_binary(#'add, lhs, rhs)

fun sub(lhs, rhs) :: Term:
  query.smt_binary(#'sub, lhs, rhs)

fun mul(lhs, rhs) :: Term:
  query.smt_binary(#'mul, lhs, rhs)

fun eq(lhs, rhs) :: Formula:
  query.smt_eq(lhs, rhs)

// Orderings of two terms of equal width, unsigned (ult, ule, ugt, uge) and
// signed (slt, sle, sgt, sge). The predicate says the signedness; a term has
// none of its own.
fun ult(lhs, rhs) :: Formula: query.smt_cmp(#'ult, lhs, rhs)
fun ule(lhs, rhs) :: Formula: query.smt_cmp(#'ule, lhs, rhs)
fun ugt(lhs, rhs) :: Formula: query.smt_cmp(#'ugt, lhs, rhs)
fun uge(lhs, rhs) :: Formula: query.smt_cmp(#'uge, lhs, rhs)
fun slt(lhs, rhs) :: Formula: query.smt_cmp(#'slt, lhs, rhs)
fun sle(lhs, rhs) :: Formula: query.smt_cmp(#'sle, lhs, rhs)
fun sgt(lhs, rhs) :: Formula: query.smt_cmp(#'sgt, lhs, rhs)
fun sge(lhs, rhs) :: Formula: query.smt_cmp(#'sge, lhs, rhs)

// That `lhs + rhs` (or `-`, or `*`) is the number it would be with room to
// spare: reading both terms as unsigned numbers, or with `~signed: #true` as
// two's complement ones, the operation does not wrap. `add`, `sub` and `mul`
// still wrap; a guard is how a query excludes the inputs for which one did.
fun no_overflow_add(lhs, rhs, ~signed: signed :: Boolean = #false) :: Formula:
  query.smt_no_overflow(#'add, lhs, rhs, signed)
fun no_overflow_sub(lhs, rhs, ~signed: signed :: Boolean = #false) :: Formula:
  query.smt_no_overflow(#'sub, lhs, rhs, signed)
fun no_overflow_mul(lhs, rhs, ~signed: signed :: Boolean = #false) :: Formula:
  query.smt_no_overflow(#'mul, lhs, rhs, signed)

// `chosen` where `test` holds, else `otherwise`: two terms of equal width.
fun ite(test, chosen, otherwise) :: Term:
  query.smt_ite(test, chosen, otherwise)

fun not(operand) :: Formula:
  query.smt_not(operand)

fun and(operand, ...) :: Formula:
  query.smt_and([operand, ...])

fun or(operand, ...) :: Formula:
  query.smt_or([operand, ...])

class Assignment(name :: String, width :: Int, value :: Int):
  method describe() :: String:
    name ++ " = " ++ query.render_term(query.smt_const(value, width))

// What a solver run established. Only `Proved` means that no counterexample
// exists, and even then only under the query's model and assumptions.
//
// `function`, `dialect`, `property`, and `assumptions` restate what was asked;
// `smtlib` is the exact query text and `command` the solver invocation, which
// together reproduce the run. `diagnostics` holds anything the solver printed.
class Outcome(function :: String,
              dialect :: String,
              property :: String,
              assumptions :: List.of(String),
              smtlib :: String,
              diagnostics :: String,
              command :: List.of(String)):
  nonfinal

  property is_proved :: Boolean: #false

  method subject() :: String:
    "`" ++ property ++ "` for @" ++ function
      ++ " under the declared SMT semantics of dialect " ++ dialect

  method describe() :: String:
    "no result for " ++ subject()

// The solver answered `unsat`: no input satisfies the assumptions while
// violating the property. With assumptions this is an implication, and
// inconsistent assumptions make it hold vacuously.
class Proved():
  extends Outcome

  override property is_proved :: Boolean: #true

  // False when the proof depends on caller-supplied preconditions.
  property is_unconditional :: Boolean: assumptions.length() == 0

  override method describe() :: String:
    if is_unconditional
    | "proved for all inputs: " ++ subject()
    | "proved only under " ++ to_string(assumptions.length()) ++ " assumption(s) ["
        ++ String.join(assumptions, "; ") ++ "]: " ++ subject()

// The query's named preconditions cannot hold together, so there is nothing
// its property is about. `core` names a set of them whose conjunction no input
// satisfies, as the solver reported it with core minimization on: none of them
// can be left out, though a different or smaller set may also be unsatisfiable.
// Preconditions without a name are part of what was asked but are never
// named, so `core` may be empty where they alone conflict. `smtlib` is the
// feasibility question: the preconditions, `(check-sat)` and
// `(get-unsat-core)`. A query none of whose preconditions is named is never
// `Infeasible`: inconsistent ones make it `Proved`, vacuously, as before.
class Infeasible(core :: List.of(String)):
  extends Outcome

  override method describe() :: String:
    "the named preconditions cannot hold together [" ++ String.join(core, "; ") ++ "]: nothing to show of "
      ++ subject()

// The solver answered `sat` and reported a complete model. `values` holds one
// assignment per function argument, in argument order.
class Counterexample(values :: List.of(Assignment)):
  extends Outcome

  override method describe() :: String:
    "counterexample ["
      ++ String.join(for List (value in values): value.describe(), ", ")
      ++ "] to " ++ subject()
      ++ (if assumptions.length() == 0
          | ""
          | " (satisfying [" ++ String.join(assumptions, "; ") ++ "])")

// The solver answered `unknown`: neither a proof nor a counterexample.
class Unknown():
  extends Outcome

  override method describe() :: String:
    "the solver could not decide " ++ subject()

// The solver exceeded `seconds` and was terminated.
class Timeout(seconds :: Real):
  extends Outcome

  override method describe() :: String:
    "the solver exceeded " ++ to_string(seconds) ++ " second(s) on " ++ subject()

// The solver could not be run or its answer could not be trusted. `kind` is
// #'missing_executable, #'nonzero_exit, #'malformed_response, #'bad_model,
// #'closed_session, or #'requirements_not_satisfied.
class Failure(kind :: Symbol):
  extends Outcome

  override method describe() :: String:
    "solver failure (" ++ to_string(kind) ++ ") on " ++ subject() ++ ": " ++ diagnostics

// An SMT dialect query: `preconditions && !property` over one function under
// one dialect's declared model. Constructing a query never runs a solver, and
// by default no tool: the lowering writes the SMT-LIB that MLIR's exporter
// gives for the module (PILLE_MLIR_SMT_EXPORT: direct, tools or both; see
// private/mlir/query.rkt `smt_export_mode`).
veneer Query(this :: satisfying(query.is_query)):
  constructor ~error

  // The SMT dialect module, verified by stock mlir-opt when first asked for;
  // it contains no custom operations.
  property module :: mlir.Module:
    query.query_module(this)

  property function :: String:
    query.query_function(this)

  // The dialect whose declared semantics the query is relative to.
  property dialect :: String:
    query.query_dialect(this)

  // [[name, width], ...] in argument order.
  property inputs :: List:
    query.query_inputs(this)

  property property :: String:
    query.render_formula(query.query_property(this))

  // The preconditions, as text. A proof holds only under these.
  property assumptions :: List.of(String):
    query.query_assumptions(this)

  // The exact SMT-LIB text given to a solver by `check`. A named
  // precondition's assertion carries its name.
  method to_smtlib() :: String:
    query.query_smtlib(this)

  // The question asked first where a precondition is named: whether the
  // preconditions can hold together. #false where none is named.
  method feasibility_smtlib() :: maybe(String):
    query.query_feasibility(this)

  // Runs a standalone solver; batch and session APIs amortize process startup.
  method check(~solver: executable :: maybe(Path || ReadableString) = #false,
               ~timeout: timeout :: PosReal = 10,
               ~arguments: arguments :: List.of(ReadableString) = []) :: Outcome:
    let answer = query.query_check(this, executable, timeout,
                                   for List (argument in arguments): to_string(argument))
    solver_outcome(answer, function, dialect, property, assumptions, to_smtlib(), timeout,
                   ~feasibility: feasibility_smtlib())

// Shared result conversion keeps old queries, batches, and sessions aligned.
fun solver_outcome(answer, function :: String, dialect :: String,
                   property :: String, assumptions :: List.of(String),
                   script :: String, timeout :: Real,
                   ~feasibility: feasibility :: maybe(String) = #false) :: Outcome:
  let diagnostics :: String = solver.solver_result_diagnostics(answer)
  let command :: List = solver.solver_result_command_line(answer)
  fun outcome(make, extra, ...) :: Outcome:
    make(function, dialect, property, assumptions, script, diagnostics, command, extra, ...)
  match solver.solver_result_status(answer)
  | #'infeasible:
      // what reproduces this answer is the feasibility question, not the query
      Infeasible(function, dialect, property, assumptions, feasibility || script, diagnostics, command,
                 solver.solver_result_core(answer))
  | #'unsat: outcome(Proved)
  | #'sat:
      outcome(Counterexample,
              for List (entry in (solver.solver_result_assignments(answer) :~ List)):
                let [name, width, value] = entry
                Assignment(name, width, value))
  | #'unknown: outcome(Unknown)
  | #'timeout: outcome(Timeout, timeout)
  | #'#{missing-executable}: outcome(Failure, #'missing_executable)
  | #'#{nonzero-exit}: outcome(Failure, #'nonzero_exit)
  | #'#{malformed-response}: outcome(Failure, #'malformed_response)
  | #'#{bad-model}: outcome(Failure, #'bad_model)
  | #'#{closed-session}: outcome(Failure, #'closed_session)
  | #'#{requirements-not-satisfied}: outcome(Failure, #'requirements_not_satisfied)

// The objective's best value over the inputs that satisfy the preconditions
// and keep every operation within what its model requires. `value` is the
// number asked for: an unsigned one, or with a signed objective a two's
// complement one. `values` is one assignment per function argument, in
// argument order, that reaches it; other inputs may reach it too. `property`
// says what was optimized. A bitvector objective always has a bound, so there
// is no outcome for an unbounded one.
class Optimum(value :: Int, values :: List.of(Assignment)):
  extends Outcome

  override method describe() :: String:
    property ++ " is " +& value ++ " for @" ++ function ++ " under the declared SMT semantics of dialect "
      ++ dialect ++ ", at [" ++ String.join(for List (assignment in values): assignment.describe(), ", ") ++ "]"
      ++ (if assumptions.length() == 0
          | ""
          | " (satisfying [" ++ String.join(assumptions, "; ") ++ "])")

// The least or greatest value of one term, over one function under one
// dialect's declared model, subject to preconditions: Dialect.smt_objective.
// Constructing one never runs a solver.
//
// MLIR's SMT dialect has no objective. The term is bound to a fresh symbol in
// the verified SMT module, and Z3's `(minimize s)` or `(maximize s)` is
// written into the exported SMT-LIB before its `(check-sat)`, with
// `(get-value ...)` after it: `to_smtlib` is that text, and running it
// through z3 prints the answer. Z3 orders bitvectors as unsigned numbers, so
// a signed objective's symbol is the term with its sign bit flipped, which
// keeps the signed order; `Optimum.value` is flipped back.
veneer ObjectiveQuery(this :: satisfying(query.is_objective)):
  constructor ~error

  // The verified SMT dialect module, before the objective is written in.
  property module :: mlir.Module:
    query.objective_module(this)

  property function :: String:
    query.objective_function(this)

  property dialect :: String:
    query.objective_dialect(this)

  // [[name, width], ...] in argument order.
  property inputs :: List:
    query.objective_inputs(this)

  // #'minimize or #'maximize, and whether the term is read as signed.
  property direction :: Symbol:
    query.objective_direction(this)

  property is_signed :: Boolean:
    query.objective_signed(this)

  property assumptions :: List.of(String):
    query.objective_assumptions(this)

  method to_smtlib() :: String:
    query.objective_smtlib(this)

  // As Query.feasibility_smtlib: #false where no precondition is named.
  method feasibility_smtlib() :: maybe(String):
    query.objective_feasibility(this)

  // What is optimized, as text: "least unsigned R".
  method describe() :: String:
    (if direction == #'minimize | "least " | "greatest ") ++ (if is_signed | "signed " | "unsigned ")
      ++ query.render_term(query.objective_term(this))

  // `Optimum`; `Infeasible` where no input satisfies the preconditions (its
  // core names which, where they are named and cannot hold together, and is
  // empty otherwise); or `Unknown`, `Timeout` or `Failure`. Runs a standalone
  // solver.
  method check(~solver: executable :: maybe(Path || ReadableString) = #false,
               ~timeout: timeout :: PosReal = 10,
               ~arguments: arguments :: List.of(ReadableString) = []) :: Outcome:
    objective_outcome(this, query.objective_check(this, executable, timeout,
                                                  for List (argument in arguments): to_string(argument)),
                      timeout)

fun objective_outcome(asked :: ObjectiveQuery, answer, timeout :: Real) :: Outcome:
  match solver.solver_result_status(answer)
  | #'optimum:
      let [[_, _, residue], [name, width, value], ...] = solver.solver_result_assignments(answer)
      Optimum(asked.function, asked.dialect, asked.describe(), asked.assumptions, asked.to_smtlib(),
              solver.solver_result_diagnostics(answer), solver.solver_result_command_line(answer),
              query.objective_value(asked, residue),
              [Assignment(name, width, value), ...])
  | ~else:
      solver_outcome(answer, asked.function, asked.dialect, asked.describe(), asked.assumptions, asked.to_smtlib(),
                     timeout, ~feasibility: asked.feasibility_smtlib())

// A spec holds the same arguments as Dialect.smt_query. Semantic validation
// happens in the batch so errors can identify the zero-based spec index.
veneer Spec(this :: satisfying(query.is_spec)):
  constructor(~function: function :: ReadableString,
              ~inputs: inputs :: List.of(Term) = [],
              ~property: property :: Formula,
              ~preconditions: preconditions :: List.of(Formula || Precondition) = []):
    query.make_spec(to_string(function), inputs, property, preconditions)

veneer Batch(this :: satisfying(query.is_batch)):
  constructor ~error

  property module :: mlir.Module: query.batch_module(this)
  property queries :: List.of(Query): query.batch_queries(this)

  // Exact exported problem script; per-question scripts are on .queries.
  // Execution additionally sends timeout options, framing and conditional
  // get-value requests, which do not change the asserted problem.
  method to_smtlib() :: String: query.batch_smtlib(this)

  method check(~solver: executable :: maybe(Path || ReadableString) = #false,
               ~timeout: timeout :: PosReal = 10,
               ~arguments: arguments :: List.of(ReadableString) = [],
               ~overall_timeout: overall_timeout :: maybe(PosReal) = #false) :: List.of(Outcome):
    let answers :: List = query.batch_check(this, executable, timeout,
                                            for List (argument in arguments): to_string(argument),
                                            overall_timeout)
    batch_outcomes(this, answers, timeout_bound(timeout, overall_timeout))

fun timeout_bound(timeout :: Real, overall :: maybe(Real)) :: Real:
  match overall
  | bound :: Real:
      if bound < timeout
      | bound
      | timeout
  | ~else: timeout

fun batch_outcomes(batch :: Batch, answers :: List, timeout :: Real) :: List.of(Outcome):
  for List (member :: Query in batch.queries, answer in answers):
    solver_outcome(answer, member.function, member.dialect, member.property,
                   member.assumptions, member.to_smtlib(), timeout,
                   ~feasibility: member.feasibility_smtlib())

// Values specs have no property: enumeration asks for the result itself.
veneer ValuesSpec(this :: satisfying(query.is_values_spec)):
  constructor(~function: function :: ReadableString,
              ~inputs: inputs :: List.of(Term) = [],
              ~preconditions: preconditions :: List.of(Formula || Precondition) = []):
    query.make_values_spec(to_string(function), inputs, preconditions)

veneer ValuesQuery(this :: satisfying(query.is_values_query)):
  constructor ~error
  property module :: mlir.Module: query.values_query_module(this)
  property function :: String: query.values_query_function(this)
  property dialect :: String: query.values_query_dialect(this)
  property inputs :: List: query.values_query_inputs(this)
  property assumptions :: List.of(String): query.values_query_assumptions(this)
  property width :: Int: query.values_query_width(this)
  method to_smtlib() :: String: query.values_query_smtlib(this)

veneer ValuesBatch(this :: satisfying(query.is_values_batch)):
  constructor ~error
  property module :: mlir.Module: query.batch_module(this)
  property queries :: List.of(ValuesQuery): query.batch_queries(this)
  method to_smtlib() :: String: query.batch_smtlib(this)

// Values are unsigned bitvector residues, sorted for deterministic reporting.
// An empty complete set means inconsistent preconditions, never a proof.
class Values(values :: List.of(Int), complete :: Boolean):
  property is_inconsistent :: Boolean: complete && values.length() == 0

  method describe() :: String:
    if is_inconsistent
    | "inconsistent preconditions: no possible result values"
    | "possible result values " ++ to_string(values)
        ++ (if complete | " (complete)" | " (limit reached; incomplete)")

// A session serializes concurrent access. Its child process is started lazily,
// closed by close() or custodian shutdown, and restarted after a timeout.
veneer Session(this :: satisfying(session.is_session)):
  constructor(~solver: executable :: maybe(Path || ReadableString) = #false,
              ~arguments: arguments :: List.of(ReadableString) = []):
    session.make_session(executable, for List (argument in arguments): to_string(argument))

  method close(): session.close_session(this)

  // A query, a batch or an objective, asked of this session's solver. Refused
  // while a scope is open on the session.
  method check(value :: Query || Batch || ObjectiveQuery,
               ~timeout: timeout :: PosReal = 10,
               ~overall_timeout: overall_timeout :: maybe(PosReal) = #false) :: Outcome || List.of(Outcome):
    match value
    | asked :: ObjectiveQuery:
        let bound = timeout_bound(timeout, overall_timeout)
        objective_outcome(asked, query.objective_session_check(this, asked, bound), bound)
    | batch :: Batch:
        let answers :: List = query.batch_session_check(this, batch, timeout, overall_timeout)
        batch_outcomes(batch, answers, timeout_bound(timeout, overall_timeout))
    | single :: Query:
        solver_outcome(query.query_session_check(this, single, timeout, overall_timeout), single.function,
                       single.dialect, single.property, single.assumptions, single.to_smtlib(),
                       timeout_bound(timeout, overall_timeout),
                       ~feasibility: single.feasibility_smtlib())

  method values(value :: ValuesQuery,
                ~limit: limit :: Int,
                ~timeout: timeout :: PosReal = 10) :: Values || Outcome:
    let answer = query.values_query_check(this, value, limit, timeout)
    if session.is_enumeration(answer)
    | Values(session.enumeration_values(answer), session.enumeration_complete(answer))
    | solver_outcome(answer, value.function, value.dialect, "possible result values",
                     value.assumptions, value.to_smtlib(), timeout)

// Assertions kept in a session's solver over one function's inputs, so that
// many questions are asked without restarting it: Dialect.smt_scope. The
// inputs are declared once, when the scope opens.
//
//   scope.assert(formula)   an assumption, for every question until its frame
//                           is popped
//   scope.push()            a new frame of assumptions
//   scope.pop()             drops the innermost frame and what it assumed
//   scope.check(property)   one question: `Proved` where the property holds
//                           for every input that satisfies what is assumed
//                           (vacuously, where nothing does), `Counterexample`
//                           with inputs for which it does not
//   scope.check_all([property, ...])
//                           the same for each, their formulas lowered together
//   scope.close()           ends the scope; the session takes other questions
//                           again
//
// A question is asked in a frame of its own that is popped again, so it leaves
// the scope as it found it. To deepen a bounded check, select a function that
// returns what each step gives, assert what holds throughout, and check one
// claim for each depth. Each question lowers its formula over the function
// anew; the solver keeps what it has learned of the assertions it holds.
//
// While a scope is open the session's `check` and `values` are refused: they
// would be asked under the scope's assumptions, or reset the solver. A timeout
// or a solver failure ends the solver process and the scope with it; `is_open`
// says whether it is still there. An outcome's `smtlib` is the question as one
// script, what the solver held and the goal, which gives the same answer run
// by itself.
veneer Scope(this :: satisfying(query.is_scope)):
  constructor ~error

  property function :: String: query.scope_function(this)
  property dialect :: String: query.scope_dialect(this)
  // [[name, width], ...] in argument order.
  property inputs :: List: query.scope_inputs(this)
  // What is assumed now, as text, outermost and earliest first.
  property assumptions :: List.of(String): query.scope_assumptions(this)
  property is_open :: Boolean: query.scope_is_open(this)

  method assert(assumption :: Formula): query.scope_assert(this, assumption)
  method push(): query.scope_push(this)
  method pop(): query.scope_pop(this)
  method close(): query.scope_close(this)

  method check(property :: Formula, ~timeout: timeout :: PosReal = 10) :: Outcome:
    let script = query.scope_goal_script(this, property)
    solver_outcome(query.scope_check(this, property, timeout), function, dialect, property.describe(),
                   assumptions, script, timeout)

  // Several claims, each answered as `check` answers one, in order. Their
  // formulas are lowered together, so the MLIR tools, where they export the
  // SMT-LIB, run once for all of them. `~timeout` bounds each question. A timeout or a failure ends the scope, and the claims after it
  // are answered `Failure` of kind `#'closed_session`.
  method check_all(properties :: List.of(Formula), ~timeout: timeout :: PosReal = 10) :: List.of(Outcome):
    let held = assumptions
    for List (property :: Formula in properties, entry :: List in (query.scope_check_all(this, properties, timeout) :: List)):
      solver_outcome(entry[1], function, dialect, property.describe(), held, entry[0], timeout)
