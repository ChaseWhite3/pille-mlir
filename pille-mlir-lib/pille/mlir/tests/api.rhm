#lang rhombus/static

import:
  pille/mlir

// Exercise the public static-language veneer, including constructor keywords
// and the return annotations that permit method chaining.
def toolchain = mlir.Toolchain(~prefix: #false, ~dialect_plugins: [], ~pass_plugins: [])
def source = @str|{
  module {
    func.func @add(%lhs: i32, %rhs: i32) -> i32 {
      %sum = arith.addi %lhs, %rhs : i32
      return %sum : i32
    }
  }
}|
def original = mlir.Module(source, ~toolchain: toolchain)
def printed = original.to_ir()

check:
  mlir.Module(printed, ~toolchain: toolchain).to_ir()
  ~is printed

def lowered = original.run_passes(
  "builtin.module(convert-arith-to-llvm,convert-func-to-llvm,reconcile-unrealized-casts)"
)
def llvm_ir :: String = lowered.to_llvm_ir()
def bitcode :: ImmutableBytes = lowered.to_bitcode()

check:
  original.to_ir()
  ~is printed

check:
  original.run_passes("builtin.module(no-such-pille-pass)")
  ~throws "mlir-opt failed"

def dialect = @str|{
  module {
    irdl.dialect @sample {
      irdl.operation @identity {
        %integer = irdl.is i32
        irdl.operands(value: %integer)
        irdl.results(result: %integer)
      }
    }
  }
}|
def custom_source = @str|{
  module {
    func.func @identity(%value: i32) -> i32 {
      %result = "sample.identity"(%value) : (i32) -> i32
      return %result : i32
    }
  }
}|
def custom = mlir.Module(custom_source, ~irdl: dialect, ~toolchain: toolchain)

check:
  custom.run_passes("builtin.module(canonicalize)")
    .run_passes("builtin.module(cse)").to_ir()
  ~is custom.to_ir()

check:
  mlir.Module(custom_source)
  ~throws "mlir-opt failed"

def smt = mlir.Module(@str|{
  module {
    smt.solver () : () -> () {
      smt.set_logic "QF_UF"
      %condition = smt.declare_fun "condition" : !smt.bool
      smt.assert %condition
      smt.check sat {} unknown {} unsat {}
    }
  }
}|)
def query :: String = smt.to_smtlib()
