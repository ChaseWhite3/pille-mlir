#lang rhombus/static/and_meta

import:
  pille/mlir
  pille/mlir/dialect open
  pille/mlir/smt
  lib("pille/private/mlir/query.rkt") as lowering

// Every question here is exported both ways, by the lowering itself and by
// mlir-translate, and the two texts must be the same.
lowering.smt_export_mode(#'both)

// Exercises the public static-language API end to end. Like the integration
// tests, this requires MLIR and Z3 (z3 on PATH or PILLE_Z3).

constraint Integer:
  same("T", i32 || i64)

dialect arithmetic("arithmetic"):
  operation add(lhs: Integer, rhs: Integer) -> (sum: Integer):
    smt:
      sum = bv.add(lhs, rhs)
  operation sub(lhs: Integer, rhs: Integer) -> (difference: Integer):
    smt:
      difference = bv.sub(lhs, rhs)
  operation annotate(value: Integer) -> (result: Integer):
    attributes(mode: attr_is("\"checked\""))

check arithmetic.operation_names ~is ["arithmetic.add", "arithmetic.sub", "arithmetic.annotate"]
check arithmetic.smt_operation_names ~is ["arithmetic.add", "arithmetic.sub"]

def program :: mlir.Module = arithmetic.module(@str|{
  module {
    func.func @round_trip(%x: i32, %y: i32) -> i32 {
      %sum = "arithmetic.add"(%x, %y) : (i32, i32) -> i32
      %difference = "arithmetic.sub"(%sum, %y) : (i32, i32) -> i32
      return %difference : i32
    }
    func.func @successor(%x: i32) -> i32 {
      %one = arith.constant 1 : i32
      %next = "arithmetic.add"(%x, %one) : (i32, i32) -> i32
      return %next : i32
    }
    func.func @annotated(%x: i32) -> i32 {
      %out = "arithmetic.annotate"(%x) {mode = "checked"} : (i32) -> i32
      return %out : i32
    }
  }
}|)

def x :: smt.Term = smt.input("x", ~width: 32)
def y :: smt.Term = smt.input("y", ~width: 32)
def result :: smt.Term = smt.result(~width: 32)

check x.width ~is 32
check x.describe() ~is "x"
check smt.add(x, smt.const(-1, ~width: 32)).describe() ~is "(x + 0xffffffff:bv32)"
check smt.eq(result, smt.mul(x, y)).describe() ~is "result == (x * y)"
check:
  smt.and(smt.eq(x, y), smt.not(smt.eq(result, x))).describe()
  ~is "(x == y && !(result == x))"
check smt.or(smt.eq(x, y)).describe() ~is "x == y"

// Terms and predicates are different sorts, and widths are never converted.
check smt.not(x) ~throws "expected a Boolean predicate"
check smt.eq(smt.eq(x, y), x) ~throws "expected bitvector terms"
check smt.eq(x, smt.input("wide", ~width: 64)) ~throws "width mismatch"
check smt.const(256, ~width: 8) ~throws "does not fit in 8 bits"
check smt.input("x", ~width: 24) ~throws "unsupported bitvector width 24"
check smt.input("check-sat", ~width: 32) ~throws "invalid input name"

// A true property: the query is a verified SMT module, exported and then
// checked by a solver only on request.
def round_trip :: smt.Query = arithmetic.smt_query(program,
                                                   ~function: "round_trip",
                                                   ~inputs: [x, y],
                                                   ~property: smt.eq(result, x))
check round_trip.function ~is "round_trip"
check round_trip.dialect ~is "arithmetic"
check round_trip.inputs ~is [["x", 32], ["y", 32]]
check round_trip.property ~is "result == x"
check round_trip.assumptions ~is []
check round_trip.module.to_smtlib() ~is round_trip.to_smtlib()
check round_trip.module.to_ir().contains("arithmetic.") ~is #false
check round_trip.to_smtlib().contains("(set-logic QF_BV)") ~is #true

def proved :: smt.Outcome = round_trip.check(~timeout: 30)
check proved ~is_a smt.Proved
check proved.is_proved ~is #true
check proved.smtlib ~is round_trip.to_smtlib()
check proved.assumptions ~is []
check:
  proved.describe()
  ~is "proved for all inputs: `result == x` for @round_trip under the declared SMT semantics of dialect arithmetic"
match proved
| unconditional :: smt.Proved:
    check unconditional.is_unconditional ~is #true
| ~else:
    check "an unsat answer is a proof" ~is #false

// A false property: the counterexample names the caller's inputs.
def successor = arithmetic.smt_query(program,
                                     ~function: "successor",
                                     ~inputs: [x],
                                     ~property: smt.eq(result, x))
match successor.check()
| refuted :: smt.Counterexample:
    check refuted.is_proved ~is #false
    check refuted.values.length() ~is 1
    let assignment = refuted.values[0]
    check [assignment.name, assignment.width] ~is ["x", 32]
    // Replay: in 32 bits, x + 1 differs from x.
    check (assignment.value + 1) mod (2 ** 32) == assignment.value ~is #false
    check refuted.describe().contains("counterexample [x = 0x") ~is #true
    check refuted.command[refuted.command.length() - 1] ~is "<query.smt2>"
| ~else:
    check "a sat answer is a counterexample" ~is #false

// With inconsistent preconditions the same false property is "proved"
// vacuously. The outcome says so instead of presenting it as unconditional.
def vacuous = arithmetic.smt_query(
  program,
  ~function: "successor",
  ~inputs: [x],
  ~property: smt.eq(result, x),
  ~preconditions: [smt.eq(x, smt.const(0, ~width: 32)), smt.eq(x, smt.const(1, ~width: 32))]
)
check vacuous.assumptions ~is ["x == 0x00000000:bv32", "x == 0x00000001:bv32"]
match vacuous.check()
| conditional :: smt.Proved:
    check conditional.is_unconditional ~is #false
    check conditional.assumptions ~is vacuous.assumptions
    check:
      conditional.describe()
      ~is ("proved only under 2 assumption(s) [x == 0x00000000:bv32; x == 0x00000001:bv32]: "
             ++ "`result == x` for @successor under the declared SMT semantics of dialect arithmetic")
| ~else:
    check "inconsistent assumptions give unsat" ~is #false

// Operational outcomes are values, not proofs.
def missing = successor.check(~solver: "/pille-test/no-such-z3")
check missing ~is_a smt.Failure
check missing.is_proved ~is #false
match missing
| failure :: smt.Failure:
    check failure.kind ~is #'missing_executable
    check failure.describe().contains("solver failure (missing_executable)") ~is #true
| ~else:
    check "a missing solver is a failure" ~is #false

// Boundaries: a schema-only operation, an unrelated module, and an undeclared input.
check:
  arithmetic.smt_query(program, ~function: "annotated", ~inputs: [x],
                       ~property: smt.eq(result, x))
  ~throws "operation 'arithmetic.annotate' has no declared SMT semantics"

check:
  arithmetic.smt_query(mlir.Module("module {}"), ~function: "f",
                       ~property: smt.eq(result, result))
  ~throws "was not verified against dialect arithmetic's generated IRDL"

check:
  arithmetic.smt_query(program, ~function: "successor", ~inputs: [x],
                       ~property: smt.eq(result, y))
  ~throws "refers to input y, which is not among the declared inputs"

//==============================================================================
// Orderings, choices, overflow guards and named preconditions (Slice A of
// CLOSER_TIMED_MACHINE_WORK_ORDER.md), as a caller writes them.

// add(x, y) is no less than x, unsigned, where the sum does not wrap
def guarded:
  arithmetic.smt_query(program, ~function: "round_trip", ~inputs: [x, y],
                       ~property: smt.eq(result, x),
                       ~preconditions: [smt.precondition(smt.no_overflow_add(x, y), ~named: "no wrap")])
check guarded.check() ~is_a smt.Proved
check guarded.assumptions ~is ["no wrap: no_overflow(x + y, unsigned)"]
check guarded.feasibility_smtlib() ~is_a String

check smt.ult(x, y).describe() ~is "x <u y"
check smt.ite(smt.sge(x, y), x, y).describe() ~is "(x >=s y ? x : y)"
check smt.result(1, ~width: 32).describe() ~is "result[1]"
check smt.no_overflow_mul(x, y, ~signed: #true).describe() ~is "no_overflow(x * y, signed)"

// two expectations that cannot both hold, and a third that is not to blame
def conflicting:
  arithmetic.smt_query(program, ~function: "successor", ~inputs: [x],
                       ~property: smt.eq(result, x),
                       ~preconditions: [smt.precondition(smt.ult(x, smt.const(10, ~width: 32)), ~named: "page.md:22"),
                                        smt.precondition(smt.ugt(x, smt.const(20, ~width: 32)), ~named: "page.md:31"),
                                        smt.precondition(smt.ult(x, smt.const(100, ~width: 32)), ~named: "page.md:40")])
match conflicting.check()
| infeasible :: smt.Infeasible:
    check infeasible.core.sort() ~is ["page.md:22", "page.md:31"]
    check infeasible.is_proved ~is #false
    check infeasible.describe().contains("the named preconditions cannot hold together") ~is #true
    // what reproduces the answer is the feasibility question
    check infeasible.smtlib ~is conflicting.feasibility_smtlib()
    check infeasible.smtlib.contains("(get-unsat-core)") ~is #true
| other:
    check other ~is_a smt.Infeasible

// a session gives the same outcome
block:
  let session = smt.Session()
  check session.check(conflicting) ~is_a smt.Infeasible
  check session.check(guarded) ~is_a smt.Proved
  session.close()

// without a name, inconsistent preconditions prove vacuously, as before
def unnamed_conflict:
  arithmetic.smt_query(program, ~function: "successor", ~inputs: [x],
                       ~property: smt.eq(result, x),
                       ~preconditions: [smt.ult(x, smt.const(10, ~width: 32)), smt.ugt(x, smt.const(20, ~width: 32))])
check unnamed_conflict.check() ~is_a smt.Proved
check unnamed_conflict.feasibility_smtlib() ~is #false

// an objective: the greatest x whose successor does not wrap, and the least signed x at least -7
def greatest:
  arithmetic.smt_objective(program, ~function: "successor", ~inputs: [x], ~maximize: x,
                           ~preconditions: [smt.no_overflow_add(x, smt.const(1, ~width: 32))])
check greatest.describe() ~is "greatest unsigned x"
check greatest.direction ~is #'maximize
check greatest.to_smtlib().contains("(maximize pille_objective)") ~is #true
match greatest.check()
| optimum :: smt.Optimum:
    check optimum.value ~is 2 ** 32 - 2
    check optimum.property ~is "greatest unsigned x"
    check (for List (a in optimum.values): [a.name, a.value]) ~is [["x", 2 ** 32 - 2]]
    check optimum.describe().contains("greatest unsigned x is 4294967294 for @successor") ~is #true
| other:
    check other ~is_a smt.Optimum

def least_signed:
  arithmetic.smt_objective(program, ~function: "successor", ~inputs: [x], ~minimize: x, ~signed: #true,
                           ~preconditions: [smt.sge(x, smt.const(-7, ~width: 32))])
match least_signed.check()
| optimum :: smt.Optimum: check optimum.value ~is -7
| other: check other ~is_a smt.Optimum

// no input at all: infeasible; and exactly one of ~minimize and ~maximize
check:
  arithmetic.smt_objective(program, ~function: "successor", ~inputs: [x], ~minimize: x,
                           ~preconditions: [smt.precondition(smt.ult(x, smt.const(0, ~width: 32)), ~named: "none")]).check()
  ~is_a smt.Infeasible
check:
  arithmetic.smt_objective(program, ~function: "successor", ~inputs: [x])
  ~throws "give exactly one of ~minimize and ~maximize"
check:
  arithmetic.smt_objective(program, ~function: "successor", ~inputs: [x], ~minimize: x, ~maximize: x)
  ~throws "give exactly one of ~minimize and ~maximize"

//==============================================================================
// A scope on a session, and an objective asked of one (Slice B).

block:
  let session = smt.Session()
  let scope = arithmetic.smt_scope(session, program, ~function: "successor", ~inputs: [x])
  check scope.is_open ~is #true
  check scope.function ~is "successor"
  check scope.inputs ~is [["x", 32]]
  scope.assert(smt.ult(x, smt.const(10, ~width: 32)))
  check scope.assumptions ~is ["x <u 0x0000000a:bv32"]
  // x < 10, so x + 1 < 11, and not always < 10
  check scope.check(smt.ult(result, smt.const(11, ~width: 32))) ~is_a smt.Proved
  match scope.check(smt.ult(result, smt.const(10, ~width: 32)))
  | refuted :: smt.Counterexample:
      check (for List (a in refuted.values): [a.name, a.value]) ~is [["x", 9]]
      check refuted.assumptions ~is ["x <u 0x0000000a:bv32"]
      check refuted.smtlib.contains("(check-sat)") ~is #true
  | other:
      check other ~is_a smt.Counterexample
  // a frame of further assumptions
  scope.push()
  scope.assert(smt.eq(x, smt.const(3, ~width: 32)))
  check scope.check(smt.eq(result, smt.const(4, ~width: 32))) ~is_a smt.Proved
  scope.pop()
  check scope.check(smt.eq(result, smt.const(4, ~width: 32))) ~is_a smt.Counterexample
  // several claims asked together, in order
  match scope.check_all([smt.ult(result, smt.const(11, ~width: 32)), smt.ult(result, smt.const(10, ~width: 32))])
  | [proved, refuted :: smt.Counterexample]:
      check proved ~is_a smt.Proved
      check (for List (a in refuted.values): [a.name, a.value]) ~is [["x", 9]]
      check refuted.property ~is "result <u 0x0000000a:bv32"
      check refuted.assumptions ~is ["x <u 0x0000000a:bv32"]
  | other:
      check other ~is "a proof and a counterexample"
  check scope.check_all([]) ~is []
  check scope.pop() ~throws "nothing was pushed on this scope"
  // the session takes nothing else while the scope is open
  check session.check(guarded) ~throws "a scope is open on this session"
  scope.close()
  check scope.is_open ~is #false
  check scope.check(smt.eq(result, result)) ~throws "the scope is closed"
  // and then it does, an objective among them
  check session.check(guarded) ~is_a smt.Proved
  match session.check(greatest)
  | optimum :: smt.Optimum: check optimum.value ~is 2 ** 32 - 2
  | other: check other ~is_a smt.Optimum
  check session.check(least_signed) ~is_a smt.Optimum
  session.close()
